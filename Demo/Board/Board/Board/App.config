<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="MyBoard"
         connectionString="data source=(localdb)\MSSQLLocalDB;initial catalog=NETBoard;integrated security=true"
         providerName="System.Data.SqlClient"
         />
  </connectionStrings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>