<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <system.serviceModel>
        <behaviors>
            <serviceBehaviors>
                <behavior name="NewBehavior0">
                    <serviceMetadata httpGetEnabled="true" httpGetUrl="http://localhost:8080/HelloService/mex"
                        httpsGetEnabled="false" />
                </behavior>
            </serviceBehaviors>
        </behaviors>
        <services>
            <service behaviorConfiguration="NewBehavior0" name="_39WCFService.HelloService">
                <endpoint address="http://localhost:8080/HelloService" binding="basicHttpBinding"
                    bindingConfiguration="" contract="_39WCFService.IHelloService" />
            </service>
        </services>
    </system.serviceModel>
</configuration>